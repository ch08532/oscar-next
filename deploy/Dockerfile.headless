FROM node:22-bookworm-slim AS build
WORKDIR /src
COPY package.json tsconfig.json ./
COPY openapi ./openapi
COPY src ./src
COPY tests ./tests
COPY apps/desktop/package.json apps/desktop/vite.headless.config.ts apps/desktop/headless.html ./apps/desktop/
COPY apps/desktop/src ./apps/desktop/src
RUN npm install
RUN npm --prefix apps/desktop install --ignore-scripts
RUN npm run build && npm --prefix apps/desktop run build:headless

FROM node:22-bookworm-slim
ENV NODE_ENV=production
WORKDIR /app
COPY --from=build /src/dist ./dist
COPY --from=build /src/apps/desktop/headless-dist ./web
COPY --from=build /src/openapi ./openapi
VOLUME ["/data"]
EXPOSE 3210
ENTRYPOINT ["node", "/app/dist/src/headless/main.js"]
CMD ["--database", "/data/oscar-next.sqlite", "--host", "0.0.0.0", "--port", "3210", "--allow-imports", "--web-root", "/app/web", "--log-dir", "/data/logs"]
