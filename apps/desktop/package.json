{
  "name": "@oscar-next/desktop",
  "version": "2.3.0",
  "private": true,
  "type": "module",
  "scripts": {
    "test:markdown": "node --test tests/expert-markdown.test.mjs",
    "icons:generate": "electron scripts/generate-icons.cjs",
    "dev": "vite",
    "build": "vite build",
    "electron": "electron ../..",
    "stage": "node scripts/stage-backend.mjs",
    "dist:win": "electron-builder --config electron-builder.yml --win nsis --x64",
    "build:headless": "vite build --config vite.headless.config.ts && node scripts/finalize-headless.mjs",
    "dist:linux:arm64": "electron-builder --config electron-builder.yml --linux deb AppImage --arm64"
  },
  "dependencies": {
    "@radix-ui/react-slot": "^1.4.0",
    "clsx": "^2.1.1",
    "lucide-react": "^1.55.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-markdown": "^10.1.0",
    "recharts": "^3.10.1",
    "remark-gfm": "^4.0.1",
    "tailwind-merge": "^3.7.0",
    "tailwind-variants": "^3.3.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^4.6.0",
    "electron": "^37.0.0",
    "electron-builder": "^26.0.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.8.3",
    "vite": "^7.0.0"
  },
  "main": "backend/src/desktop/main.js"
}
